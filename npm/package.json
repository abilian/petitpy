{
  "name": "petitpy",
  "version": "0.0.0",
  "description": "A small Python runtime for the browser: MicroPython-compatible, written in Zig, 333 KB of wasm with direct DOM access.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./embed": { "types": "./embed.d.ts", "default": "./embed.js" },
    "./petitpy.wasm": "./petitpy.wasm",
    "./petitpy-embed.wasm": "./petitpy-embed.wasm",
    "./js-bridge.js": "./js-bridge.js"
  },
  "files": ["index.js", "index.d.ts", "embed.js", "embed.d.ts", "js-bridge.js", "wasi-fs.js", "petitpy.wasm", "petitpy-embed.wasm", "README.md", "LICENSE"],
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2"
  },
  "keywords": ["python", "micropython", "wasm", "webassembly", "interpreter", "browser"],
  "license": "MIT AND PSF-2.0",
  "homepage": "https://petitpy.lab.abilian.com/",
  "repository": { "type": "git", "url": "https://github.com/abilian/petitpy" }
}
