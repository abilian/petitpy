# Build artifacts
.zig-cache/
zig-out/

# ADR-003 L2 — pre-compiled .mpy bytes for frozen-tiny modules
# (regenerate: `make freeze`).
build-frozen/

# Vendored upstream code, none of it committed: vendor/micropython is the
# MicroPython clone pinned by MICROPY_REV (`make bootstrap`, or a symlink to
# an external checkout); vendor/micropython_embed is generated from it by
# `make port`.
vendor/

# embed.mk build dir
port/build-embed/

# Local scratch space. Nothing a build or a gate needs may live here.
sandbox/
notes/scratch/
.workflow-tmp/
coverage/
notes/tech-reports/TR-001.pdf
web/nanopython.wasm
# Copied from golden-programs/works/ by tools/gen_gallery.py.
web/gallery/

# Zensical static-site output (regenerate: `make doc-build`)
site/
# release artifacts (`make release-dist`, `make npm-package`)
/dist/
npm/dist/
