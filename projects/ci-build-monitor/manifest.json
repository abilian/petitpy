{
  "manifest_version": 3,
  "name": "Nano Build Monitor",
  "short_name": "NanoBuilds",
  "description": "Monitor CI builds across Sourcehut, GitHub, and GitLab (nanopython port)",
  "version": "1.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "nano-build-monitor@fermigier.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://builds.sr.ht/*",
    "https://api.github.com/*",
    "https://gitlab.com/api/*"
  ],
  "background": {
    "service_worker": "dist/background-loader.js",
    "scripts": ["dist/background-loader.js"],
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Nano Build Monitor"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
